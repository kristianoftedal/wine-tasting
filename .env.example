# Supabase Configuration
# Public (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (server-side only, for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI Configuration (for embeddings and AI features)
OPENAI_API_KEY=your-openai-api-key

# Optional: override the active weight profile (inverted | moderate)
# NEXT_PUBLIC_WEIGHT_PROFILE=inverted

# Optional: canonical site URL (metadata) and local-dev auth redirect
# NEXT_PUBLIC_SITE_URL=https://your-site.example
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Optional: note enrichment — one search provider (checked in this order)
# SERPER_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Bearer token for /api/admin/note-enrichment
# NOTE_ENRICHMENT_TOKEN=
# Comma-separated emails allowed to approve notes in /admin/notater (unset = nobody)
# NOTE_REVIEW_ADMINS=
